# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for video scoring.
# Default: gemini-3.8-flash
GEMINI_MODEL=

# Optional: rate limits for your API key's tier (requests/minute, requests/day).
# Defaults below match the free tier. Raise these if you're on a paid tier.
GEMINI_RPM=5
GEMINI_RPD=20

# Optional: how many clips to score concurrently (uploads run fully parallel;
# only the actual inference call is throttled to GEMINI_RPM).
GEMINI_MAX_WORKERS=5

# Google Drive folder holding the raw source clips.
# Folder ID from a URL like https://drive.google.com/drive/folders/<FOLDER_ID>
DRIVE_FOLDER_ID=11wqrM-adEEqGdxiisENYcYCqAOFLK4aU

# Recommended: path to a Google service account JSON key (Drive API
# enabled on its Cloud project). This is the most robust ingestion path —
# uses google-api-python-client's official chunked/retryable download —
# and does NOT require re-sharing the folder with the service account's
# email if the folder is already "Anyone with the link" (that setting
# already grants access to any Google identity, service accounts included).
# Create one at: https://console.cloud.google.com/iam-admin/serviceaccounts
# -> Create service account -> Keys -> Add key -> JSON, then enable the
# "Google Drive API" for that project.
# NEVER commit the actual key file — keep its filename matching a
# .gitignore pattern (credentials*.json / service_account*.json).
GOOGLE_SERVICE_ACCOUNT_FILE=

# Fallback only: a plain Google API key with the "Google Drive API"
# enabled. Simpler to set up than a service account, but Drive's
# front-door anti-abuse system treats bare-API-key requests as anonymous
# traffic and is more prone to blocking binary downloads under load
# (confirmed hands-on and against multiple independent reports — see
# drive_ingest.py's module docstring). Prefer the service account above;
# only use this if you can't create one.
# Create one at: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=

# How many files to download concurrently via the Drive API path.
DRIVE_MAX_WORKERS=6

# Which video encoder every ffmpeg-calling stage uses: "videotoolbox"
# (Apple hardware H.264, macOS only) or "libx264" (software). Measured on
# an M1: videotoolbox is faster per job and uses much less CPU, but does
# NOT benefit from concurrency (multiple hardware sessions serialize
# rather than parallelize) — trades a real quality difference (-q:v vs
# -crf, hardware H.264 is lower quality per bitrate than libx264 at
# comparable settings) for speed and lower CPU load. See config.py and
# the README's "FFMPEG_MAX_WORKERS" section for the full measured
# comparison. Default: videotoolbox.
VIDEO_ENCODER=videotoolbox

# How many concurrent ffmpeg processes to run for the rotation-normalize
# and merge pipeline stages. Default depends on VIDEO_ENCODER: 1 for
# videotoolbox (concurrency doesn't help it — measured), 2 for libx264
# (software encoding genuinely parallelizes). Raise the libx264 case if
# you know you have CPU/RAM headroom (check core count/RAM before going
# much above 3-4); raising it for videotoolbox has no measured benefit.
FFMPEG_MAX_WORKERS=1

# Override if CapCut's draft root isn't at the OS default.
# macOS default: ~/Movies/CapCut/User Data/Projects/com.lveditor.draft
# Windows default: %USERPROFILE%\AppData\Local\JianyingPro\User Data\Projects\com.lveditor.draft
CAPCUT_DRAFT_ROOT=
